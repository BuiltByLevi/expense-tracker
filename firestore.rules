rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // EXPENSES: Users can only read/write their own expenses
    match /expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userid;
    }

    // INCOME: Users can only read/write their own income transactions
    match /income/{incomeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userid;
    }

    // STATEMENT IMPORTS: Users can only read/write their own import records
    // (metadata only — the original uploaded file is never stored)
    match /statementImports/{importId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userid;
    }

    // USER SETTINGS: Users can only access their own settings
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // EARNINGS HISTORY subcollection (per-month earnings)
      match /earningsHistory/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
